#!/bin/sh
# Rejects commit messages that do not follow Conventional Commits as described in AGENTS.md (Commits): the identity
# and trailer rules here, the format through Commitizen and .cz.toml (DEC-150 (1)), the same check as the job pr-title.
# Enable once per clone: git config core.hooksPath .githooks
# Install Commitizen once: python -m pip install --require-hashes -r tools/requirements.txt

message=$(tr -d '\r' < "$1" | grep -v '^#')

# Every commit carries the owner's name only (AGENTS.md, Commits); the PR gates check it again.
case "$(git var GIT_AUTHOR_IDENT) $(git var GIT_COMMITTER_IDENT)" in
  *"<noreply@anthropic.com>"*)
    echo "commit-msg: commit as the owner: set git user.name and user.email (AGENTS.md, Commits)" >&2
    exit 1 ;;
esac
if printf '%s\n' "$message" | grep -Eiq '^[[:space:]]*(Co-Authored-By|Claude-Session)[[:space:]]*:'; then
  echo "commit-msg: remove the Co-Authored-By and Claude-Session trailers (AGENTS.md, Commits)" >&2
  exit 1
fi

# cz on PATH, else the venv out/.venv of CLAUDE.md (Local environment), else the module in python3 or python
# (Windows); no Commitizen stops the commit. Git runs the hook from the root of the clone.
if command -v cz >/dev/null 2>&1; then
  set -- cz check --commit-msg-file "$1"
elif [ -x out/.venv/bin/cz ]; then
  set -- out/.venv/bin/cz check --commit-msg-file "$1"
elif [ -x out/.venv/Scripts/cz.exe ]; then
  set -- out/.venv/Scripts/cz.exe check --commit-msg-file "$1"
elif python3 -c 'import commitizen' >/dev/null 2>&1; then
  set -- python3 -m commitizen check --commit-msg-file "$1"
elif python -c 'import commitizen' >/dev/null 2>&1; then
  set -- python -m commitizen check --commit-msg-file "$1"
else
  echo "commit-msg: Commitizen is not installed (DEC-150 (1)). Install it once, then commit again:" >&2
  echo "  python -m pip install --require-hashes -r tools/requirements.txt" >&2
  exit 1
fi
if ! "$@" >/dev/null 2>&1; then
  echo "commit-msg: the message does not follow the convention (.cz.toml, AGENTS.md, section Commits)" >&2
  echo "  got:      $(printf '%s\n' "$message" | sed -n '1p')" >&2
  echo "  expected: <type>(<scope>): <subject>, then a blank line" >&2
  echo "  types: feat fix docs refactor perf test build ci chore revert   scopes: api web db seed docs ci" >&2
  echo "  subject: 1 to 72 characters, not starting with a capital letter, no final period" >&2
  exit 1
fi
exit 0
