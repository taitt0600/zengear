root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{cs,csx}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

# Xml files
[*.xml]
indent_size = 2

[*.cs]
csharp_style_namespace_declarations = file_scoped:warning
dotnet_diagnostic.IDE0130.severity = warning
dotnet_diagnostic.CA2007.severity = none

# EF Core migrations are generated by dotnet ef: no style rules
[src/ZenGear.Data/Migrations/*.cs]
generated_code = true
