root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{cs,csx}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

# Xml files
[*.xml]
indent_size = 2

[*.cs]
csharp_style_namespace_declarations = file_scoped:warning
dotnet_diagnostic.IDE0130.severity = warning
dotnet_diagnostic.CA2007.severity = none
# Cognitive complexity, unused private members and private members never read: errors in every build (DEC-152 (7)).
# IDE rules default to a suggestion, which the build does not report.
dotnet_diagnostic.S3776.severity = error
dotnet_diagnostic.IDE0051.severity = error
dotnet_diagnostic.IDE0052.severity = error

# EF Core migrations are generated by dotnet ef: no style rules
[src/ZenGear.Data/Migrations/*.cs]
generated_code = true

# EF Core sets entity properties through their backing fields, so their private setters look unused to
# Sonar (false positive confirmed by SonarSource, community.sonarsource.com/t/116273).
# IDE0051/IDE0052 (errors, set above for every .cs file) still catch unused private methods and fields in entities.
[src/ZenGear.Data/Entities/**.cs]
dotnet_diagnostic.S1144.severity = none
