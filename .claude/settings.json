{
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "Bash(git fetch origin *)",
      "Bash(git rebase origin/main)",
      "Bash(git push -u origin HEAD)",
      "Bash(git push origin HEAD)",
      "Bash(git push --force-with-lease origin HEAD)",
      "Bash(git config user.name taitt0600)",
      "Bash(git config user.email taitt.dev@gmail.com)",
      "Bash(git config core.hooksPath .githooks)",
      "Bash(dotnet build *)",
      "Bash(dotnet test *)",
      "Bash(dotnet tool restore)",
      "Bash(dotnet ef migrations add *)",
      "Bash(dotnet ef migrations has-pending-model-changes *)",
      "Bash(dotnet ef database update *)",
      "Bash(python3 tools/pr_gates.py *)",
      "Bash(python tools/pr_gates.py *)",
      "Bash(python3 tools/github_pr.py *)",
      "Bash(python tools/github_pr.py *)",
      "Bash(python3 tools/schema_compare.py *)",
      "Bash(python3 ../tools/schema_compare.py *)",
      "Bash(gh issue list *)",
      "Bash(gh issue view *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)"
    ],
    "ask": [],
    "deny": [
      "Bash(git commit *--no-verify*)",
      "Bash(git commit -n*)",
      "Bash(git commit * -n*)",
      "Bash(git commit *--amend*)",
      "Bash(git -c *)",
      "Bash(git -C *)",
      "Bash(git push --force)",
      "Bash(git push --force *)",
      "Bash(git push * --force)",
      "Bash(git push * --force *)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push --mirror*)",
      "Bash(git push * --mirror*)",
      "Bash(git push --delete*)",
      "Bash(git push * --delete*)",
      "Bash(git push * -d *)",
      "Bash(git push * +*)",
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push *:main)",
      "Bash(git push *:refs/heads/main)",
      "Bash(gh pr merge *)",
      "Bash(gh repo delete *)",
      "Bash(gh repo edit *)",
      "Bash(gh repo rename *)",
      "Bash(gh repo archive *)",
      "Bash(gh api *)",
      "Bash(gh auth *)",
      "Bash(curl *api.github.com*)",
      "Read(./**/.env*)",
      "Read(./**/*service-account*.json)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh",
            "args": [
              "-NoProfile",
              "-File",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-spec.ps1"
            ]
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh",
            "args": [
              "-NoProfile",
              "-File",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/stop-check.ps1"
            ],
            "timeout": 300
          }
        ]
      }
    ]
  }
}
