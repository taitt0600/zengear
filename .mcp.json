{
  "mcpServers": {
    "zengear": {
      "command": "docker",
      "args": ["mcp", "gateway", "run", "--profile", "zengear"]
    },
    "postgres": {
      "command": "docker",
      "args": [
        "run", "-i", "--rm", "-e", "DATABASE_URI",
        "crystaldba/postgres-mcp:0.3.0@sha256:dbbd346860d29f1543e991f30f3284bf4ab5f096d049ecc3426528f20b1b6e6b",
        "--access-mode=unrestricted"
      ],
      "env": {
        "DATABASE_URI": "${ZENGEAR_MCP_DATABASE_URI}"
      }
    }
  }
}
